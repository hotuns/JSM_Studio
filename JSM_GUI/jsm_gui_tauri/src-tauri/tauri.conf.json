{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSM Studio",
  "version": "0.2.5",
  "identifier": "com.hotuns.jsmstudio",
  "build": {
    "beforeDevCommand": "npm run verify:drivers && npm run build:sidecars && npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run verify:drivers && npm run build:sidecars && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSM Studio",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "bin": "bin",
      "drivers": "drivers"
    },
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFOTg4ODczNDg3ODlBMkMKUldRc21uaEljNGlZTGpIRWVDKy9tVXNCaGVBdE1EckZMVVBPdmRpR0E3bDZqWTYra2NvLzFzZk0K",
      "endpoints": [
        "https://github.com/hotuns/JSM_Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
